{
    "name": "awcodes/vitals",
    "description": "Website uptime, certificate and incident monitoring for Filament panels, built on spatie/laravel-uptime-monitor.",
    "type": "library",
    "keywords": [
        "awcodes",
        "laravel",
        "filament",
        "uptime",
        "monitoring",
        "plugin"
    ],
    "homepage": "https://github.com/awcodes/vitals",
    "support": {
        "issues": "https://github.com/awcodes/vitals/issues",
        "source": "https://github.com/awcodes/vitals"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Adam Weston",
            "email": "adam@aw.codes",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-uptime-monitor": "^4.7"
    },
    "require-dev": {
        "awcodes/focus": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0",
        "sandermuller/package-boost-laravel": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Awcodes\\Vitals\\": "src/",
            "Awcodes\\Vitals\\Database\\Factories\\": "database/factories/",
            "Awcodes\\Vitals\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Awcodes\\Vitals\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "lint": "pint",
        "refactor": "rector",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse",
        "test:unit": "pest",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "focus": [
            "Composer\\Config::disableProcessTimeout",
            "focus"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Awcodes\\Vitals\\VitalsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
